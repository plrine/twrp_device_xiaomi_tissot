From 77dab385cdf7819f06911fdc484d4eb398b165a3 Mon Sep 17 00:00:00 2001
From: Raya Mahardika <94042378+rktdnt@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:55:06 +0000
Subject: [PATCH 3/3] recovery: Fix /sdcard bind mount on eMMC devices and
 protect decrypted FBE /data

- Fix Post_Decrypt skipping Bind_Mount on eMMC devices where block device begins with /dev/block/mmcblk
- Properly detach any stale mount and bind mount /data/media/0 to /sdcard
- Disallow unmounting /data from the GUI Mount menu while FBE is decrypted to prevent wiping the kernel keyring
- Do not unmount /data during Setup_Data_Media or UnMount_Main_Partitions if FBE is present
- Run Decrypt_DE on /data mount and before user decrypt
- Fallback to /vendor/etc/build.prop when /vendor/build.prop is empty

Signed-off-by: Raya Mahardika <94042378+rktdnt@users.noreply.github.com>
---
 gui/partitionlist.cpp |  5 +++++
 partition.cpp         | 11 +++++++++--
 partitionmanager.cpp  | 24 +++++++++++++++++-------
 3 files changed, 31 insertions(+), 9 deletions(-)

diff --git a/gui/partitionlist.cpp b/gui/partitionlist.cpp
index 294f6d78..d5edace5 100644
--- a/gui/partitionlist.cpp
+++ b/gui/partitionlist.cpp
@@ -32,6 +32,7 @@ extern "C" {
 #include "objects.hpp"
 #include "../data.hpp"
 #include "../partitions.hpp"
+#include "../variables.h"
 
 GUIPartitionList::GUIPartitionList(xml_node<>* node) : GUIScrollList(node)
 {
@@ -318,6 +319,10 @@ void GUIPartitionList::NotifySelect(size_t item_selected)
 					mUpdate = 1;
 				}
 			} else {
+				if (mList.at(item_selected).Mount_Point == "/data" && DataManager::GetIntValue(TW_IS_FBE) && DataManager::GetIntValue(TW_IS_DECRYPTED)) {
+					gui_err("cannot_unmount_data=Data cannot be unmounted while decrypted.");
+					return;
+				}
 				if (PartitionManager.UnMount_By_Path(mList.at(item_selected).Mount_Point, true)) {
 					mList.at(item_selected).selected = 0;
 					mUpdate = 1;
diff --git a/partition.cpp b/partition.cpp
index 8f494353..dba3558d 100644
--- a/partition.cpp
+++ b/partition.cpp
@@ -1327,7 +1327,8 @@ void TWPartition::Setup_Data_Media() {
 			Storage_Path = Mount_Point + "/media/0";
 			Symlink_Path = Storage_Path;
 			DataManager::SetValue(TW_INTERNAL_PATH, Mount_Point + "/media/0");
-			UnMount(true);
+			if (!Is_FBE && !DataManager::GetIntValue(TW_IS_FBE))
+				UnMount(true);
 		}
 		DataManager::SetValue("tw_has_internal", 1);
 		DataManager::SetValue("tw_has_data_media", 1);
@@ -1382,7 +1383,8 @@ void TWPartition::Setup_Data_Media() {
 		if (Mount(true) && TWFunc::Path_Exists(Mount_Point + "/media/0")) {
 			Storage_Path = Mount_Point + "/media/0";
 			Symlink_Path = Storage_Path;
-			UnMount(true);
+			if (!Is_FBE && !DataManager::GetIntValue(TW_IS_FBE))
+				UnMount(true);
 		}
 	}
 	ExcludeAll(Mount_Point + "/media");
@@ -1790,6 +1792,11 @@ exit:
 		if (!Bind_Mount(false))
 			return false;
 	}
+#if defined(TW_INCLUDE_CRYPTO) && defined(TW_INCLUDE_FBE)
+	if (Mount_Point == "/data" && (Is_FBE || DataManager::GetIntValue(TW_IS_FBE))) {
+		android::keystore::Decrypt_DE();
+	}
+#endif
 	return true;
 }
 
diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index 13411bb0..dd4067bd 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -189,13 +189,15 @@ void inline Reset_Prop_From_Partition(std::string prop, std::string def, TWParti
 	}
 	if (ven) {
 		string vendor_prop = TWFunc::Partition_Property_Get(prop, PartitionManager, "/vendor", "build.prop");
+		if (vendor_prop.empty())
+			vendor_prop = TWFunc::Partition_Property_Get(prop, PartitionManager, "/vendor", "etc/build.prop");
 		if (!vendor_prop.empty()) {
 			prop_on_vendor = true;
 			if (TWFunc::Property_Override(prop, vendor_prop) == NOT_AVAILABLE) {
 				LOGERR("Unable to override '%s' due to missing libresetprop\n", prop.c_str());
 			} else {
 				prop_value = android::base::GetProperty(prop, "");
-				LOGINFO("Setting '%s' to '%s' from /vendor/build.prop\n", prop.c_str(), prop_value.c_str());
+				LOGINFO("Setting '%s' to '%s' from /vendor build.prop\n", prop.c_str(), prop_value.c_str());
 			}
 		}
 	}
@@ -208,7 +210,7 @@ void inline Reset_Prop_From_Partition(std::string prop, std::string def, TWParti
 		}
 	}
 	prop_value = android::base::GetProperty(prop, "");
-	if (!prop_on_odm && !prop_on_vendor && !prop_value.empty() && def.empty()) {
+	if (!prop_on_odm && !prop_on_vendor && !prop_value.empty() && def == "delete") {
 		if(TWFunc::Delete_Property(prop) == NOT_AVAILABLE) {
 			LOGERR("Unable to delete '%s' due to missing libresetprop\n", prop.c_str());
 		} else {
@@ -2219,12 +2221,18 @@ void TWPartitionManager::Post_Decrypt(const string& Block_Device) {
 		DataManager::SetValue("tw_settings_path", Fox_Home);
 		LOGINFO("New storage path after decryption: %s\n", dat->Storage_Path.c_str());
 
+		if (!dat->Symlink_Mount_Point.empty()) {
+			umount2(dat->Symlink_Mount_Point.c_str(), MNT_DETACH);
+			if (!dat->Bind_Mount(false))
+				LOGERR("Unable to bind mount %s to %s\n", dat->Symlink_Mount_Point.c_str(), dat->Storage_Path.c_str());
+			else
+				LOGINFO("Successfully bind mounted %s to %s\n", dat->Symlink_Mount_Point.c_str(), dat->Storage_Path.c_str());
+		}
+
+		DataManager::SetValue("tw_file_location1", "/sdcard");
+
 		Update_System_Details();
 		Output_Partition(dat);
-		if (!android::base::StartsWith(dat->Actual_Block_Device, "/dev/block/mmcblk")) {
-		if (!dat->Bind_Mount(false))
-			LOGERR("Unable to bind mount /sdcard to %s\n", dat->Storage_Path.c_str());
-		}
 	} else
 		LOGERR("Unable to locate data partition.\n");
 }
@@ -2358,6 +2366,8 @@ int TWPartitionManager::Decrypt_Device(string Password, int user_id) {
 		if (!Mount_By_Path("/data", true)) // /data has to be mounted for FBE
 			return -1;
 
+		android::keystore::Decrypt_DE();
+
 		bool user_need_decrypt = false;
 		std::vector<users_struct>::iterator iter;
 		for (iter = Users_List.begin(); iter != Users_List.end(); iter++) {
@@ -2638,7 +2648,7 @@ void TWPartitionManager::UnMount_Main_Partitions(void) {
 	UnMount_By_Path (Get_Android_Root_Path(), true);
 	Partition = Find_Partition_By_Path ("/product");
 	if (Partition != NULL) UnMount_By_Path("/product", false);
-	if (!datamedia)
+	if (!datamedia && !DataManager::GetIntValue(TW_IS_FBE))
 		UnMount_By_Path("/data", true);
 
 	Partition = Find_Partition_By_Path ("/boot");

# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                      <mnt_point>     <type>      <mnt_flags and options>                             <fs_mgr_flags>
/dev/block/bootdevice/by-name/config        /frp            emmc        defaults                                            defaults,wipeingui
/dev/block/bootdevice/by-name/logdump       /metadata       ext4        noatime,nosuid,nodev,discard,data=journal,commit=1  wait,check,formattable
/dev/block/bootdevice/by-name/misc          /misc           emmc        defaults                                            defaults
/dev/block/bootdevice/by-name/userdata      /data           f2fs        nosuid,nodev,noatime,discard,fsync_mode=nobarrier   wait,check,fileencryption=aes-256-xts:aes-256-cts:v2,quota
/dev/block/bootdevice/by-name/userdata      /data           ext4        nosuid,nodev,noatime,noauto_da_alloc                wait,check,fileencryption=aes-256-xts:aes-256-cts:v2,quota,formattable
